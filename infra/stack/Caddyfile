# Internal reverse proxy for staging (ADR-0010). HTTPS is Cloudflare's job: the tunnel forwards
# requests here over the stack's private network, so Caddy only listens on plain HTTP and
# publishes no port.
{
	auto_https off
}

:80 {
	encode zstd gzip
	# Metrics are for whoever operates the VM, not the internet (TD-29).
	@internal path /metrics
	respond @internal 404
	# Public pages the app, Google sign-in and Google Play link to (infra/site).
	@pages path /terms /privacy /delete-account /beta
	handle @pages {
		root * /srv/site
		rewrite * {path}.html
		file_server
	}
	# Icons for browsers (favicon.ico requests get the PNG; every browser accepts it).
	# The home page's images.
	handle /img/* {
		root * /srv/site
		file_server
	}
	@icons path /favicon.ico /favicon.png /apple-touch-icon.png
	handle @icons {
		root * /srv/site
		rewrite /favicon.ico /favicon.png
		file_server
	}
	# The home page (what Riffscribe is; Google sign-in and Play list it as the website).
	handle / {
		root * /srv/site
		rewrite * /index.html
		file_server
	}
	reverse_proxy api:8000
}
