# Internal reverse proxy for staging (ADR-0010). HTTPS is Cloudflare's job: the tunnel forwards
# requests here over the stack's private network, so Caddy only listens on plain HTTP and
# publishes no port.
{
	auto_https off
}

:80 {
	encode zstd gzip
	# Metrics are for whoever operates the VM, not the internet (TD-29).
	@internal path /metrics
	respond @internal 404
	# Public pages the app and Google Play link to (infra/site): terms, privacy, account deletion.
	@pages path /terms /privacy /delete-account
	handle @pages {
		root * /srv/site
		rewrite * {path}.html
		file_server
	}
	reverse_proxy api:8000
}
