# One environment's secrets and settings (staging ADR-0010, production ADR-0012). Copy to
# `.env` ON THE VM, at /srv/riffscribe/stack/.env; never commit the real file. docker compose
# reads it. Every value marked "Secret" is different for staging and production.

# staging or prod: names the compose project (riffscribe-<ENVIRONMENT>).
ENVIRONMENT=staging

# The commit running: images ghcr.io/$IMAGE_OWNER/riffscribe-{api,worker}:$TAG. Written by
# `make deploy`; leave it empty here.
TAG=
IMAGE_OWNER=sumitga

# The API's public hostname (the tunnel's public hostname in Cloudflare; deploy checks it).
# Staging: riffscribe-staging.sumitgautam.tech; production: riffscribe.sumitgautam.tech.
PUBLIC_HOST=riffscribe-staging.sumitgautam.tech

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > riffscribe-<env> > install
# command, the long string after `--token`. Secret.
TUNNEL_TOKEN=

# Postgres (on the VM's data volume). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Cloudflare R2 (S3 API). Endpoint: https://<account id>.r2.cloudflarestorage.com
# The token needs Object Read & Write on this bucket only (riffscribe-staging / riffscribe-prod).
S3_BUCKET=riffscribe-staging
S3_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Clerk: the instance the app signs in with (its JWKS is $JWT_ISSUER/.well-known/jwks.json).
# Staging: the development instance below; production: the production instance's Frontend API
# URL (Clerk dashboard > API keys, e.g. https://clerk.sumitgautam.tech).
JWT_ISSUER=https://civil-frog-613.clerk.accounts.dev
# Clerk secret key (dashboard > API keys), so "Delete account" also deletes the sign-in. Secret.
CLERK_SECRET_KEY=

# Who may use the admin section at /admin (ADR-0015): Clerk user IDs (user_...), comma-separated.
# Empty: nobody. A signed-in account that isn't listed sees its own ID on the page, to add here.
ADMIN_USER_IDS=

# Optional: only if push security is turned on for the Expo project.
EXPO_ACCESS_TOKEN=

# Transcriptions per user per month (staging 100 for testing; production the free tier, 10).
FREE_JOBS_PER_MONTH=100

# The VM network's MTU (`ip link` on the VM); the stack's Docker network must match it.
NETWORK_MTU=1442
