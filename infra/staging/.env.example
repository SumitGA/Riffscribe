# Staging secrets and settings (ADR-0010). Copy to `.env` ON THE VM (deploy-staging puts it at
# /srv/riffscribe/stack/.env); never commit the real file. docker compose reads it.

# The commit to run: images ghcr.io/$IMAGE_OWNER/riffscribe-{api,worker}:$TAG. deploy-staging
# sets it; this is only the fallback.
TAG=
IMAGE_OWNER=sumitga

# HTTPS: the API's hostname (DNS A record -> the VM's floating IP) and the contact email
# Let's Encrypt uses for expiry notices.
STAGING_HOST=api-staging.example.com
ACME_EMAIL=you@example.com

# Postgres (on the VM's data volume). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Cloudflare R2 (S3 API). Endpoint: https://<account id>.r2.cloudflarestorage.com
# The token needs Object Read & Write on this bucket only.
S3_BUCKET=riffscribe-staging
S3_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Clerk: the instance the app signs in with (its JWKS is $JWT_ISSUER/.well-known/jwks.json).
JWT_ISSUER=https://civil-frog-613.clerk.accounts.dev

# Optional: only if push security is turned on for the Expo project.
EXPO_ACCESS_TOKEN=

# Transcriptions per user per month on staging.
FREE_JOBS_PER_MONTH=100
