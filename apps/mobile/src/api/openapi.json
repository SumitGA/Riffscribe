{
  "openapi": "3.1.0",
  "info": {
    "title": "TabScribe API",
    "version": "0.1.0"
  },
  "paths": {
    "/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Create Job",
        "description": "Step 1: create a job and get a presigned URL to upload the audio to.",
        "operationId": "create_job_jobs_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List Jobs",
        "description": "The caller's jobs, newest first (uses the jobs(user_id, created_at) index).",
        "operationId": "list_jobs_jobs_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/submit": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Submit Job",
        "description": "Step 3: check the upload and the quota, then queue the job. Safe to repeat.\n\nOnly size, type and quota are checked here (one HEAD request). Duration and format need\nthe audio decoded, so the normalize stage checks them and fails the job if they're wrong.",
        "operationId": "submit_job_jobs__job_id__submit_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job",
        "description": "Step 5: poll a job's status; once it has succeeded, `outputs` has download links.",
        "operationId": "get_job_jobs__job_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "jobs"
        ],
        "summary": "Delete Job",
        "description": "Delete a job, its scores and its files. It still counts towards this month's quota.\n\nA running job can be deleted too: its worker drops the job's remaining stages and removes\nany files it writes after this (worker.handler).",
        "operationId": "delete_job_jobs__job_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/me/push-tokens": {
      "put": {
        "tags": [
          "push"
        ],
        "summary": "Register Push Token",
        "description": "Notify this device about the caller's jobs. Safe to repeat; a device that was another\nuser's moves to the caller (it signed in as someone else).",
        "operationId": "register_push_token_me_push_tokens_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushTokenIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/me/push-tokens/{token}": {
      "delete": {
        "tags": [
          "push"
        ],
        "summary": "Remove Push Token",
        "description": "Stop notifying this device (sign-out, or notifications turned off). Only the caller's own\ntokens can be removed; anything else is quietly ignored, so this can't probe tokens.",
        "operationId": "remove_push_token_me_push_tokens__token__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 255,
              "title": "Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/versions": {
      "post": {
        "tags": [
          "versions"
        ],
        "summary": "Create Version",
        "description": "Save edits as a new version. 409 if `base_version` isn't the latest (another save won)\nor the previous save is still being rendered; the app reloads and tries again.",
        "operationId": "create_version_jobs__job_id__versions_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVersionRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "versions"
        ],
        "summary": "List Versions",
        "operationId": "list_versions_jobs__job_id__versions_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/versions/{number}": {
      "get": {
        "tags": [
          "versions"
        ],
        "summary": "Get Version",
        "operationId": "get_version_jobs__job_id__versions__number__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "description": "Liveness: the process is up.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readyz",
        "description": "Readiness: Postgres and Redis answer. Object storage isn't checked: it's a remote service\nwhose outage shouldn't take every API instance out of the load balancer.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readyz Readyz Get"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Me",
        "description": "Who the bearer token belongs to, and how much of this month's quota is used.",
        "operationId": "me_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateJobRequest": {
        "properties": {
          "instrument": {
            "$ref": "#/components/schemas/Instrument"
          },
          "tuning": {
            "$ref": "#/components/schemas/Tuning",
            "default": "standard"
          },
          "capo": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 0.0,
            "title": "Capo",
            "default": 0
          },
          "content_type": {
            "type": "string",
            "title": "Content Type",
            "description": "One of: audio/aac, audio/flac, audio/mp4, audio/mpeg, audio/ogg, audio/wav, audio/wave, audio/x-m4a, audio/x-wav"
          },
          "size_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes",
            "description": "Size of the file the client will upload"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Optional title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "instrument",
          "content_type",
          "size_bytes"
        ],
        "title": "CreateJobRequest"
      },
      "CreateJobResponse": {
        "properties": {
          "job": {
            "$ref": "#/components/schemas/JobOut"
          },
          "upload": {
            "$ref": "#/components/schemas/PresignedRequestOut"
          }
        },
        "type": "object",
        "required": [
          "job",
          "upload"
        ],
        "title": "CreateJobResponse"
      },
      "CreateVersionRequest": {
        "properties": {
          "base_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Base Version"
          },
          "edits": {
            "items": {
              "$ref": "#/components/schemas/EditOp"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Edits"
          },
          "from_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "From Version"
          }
        },
        "type": "object",
        "required": [
          "base_version",
          "edits"
        ],
        "title": "CreateVersionRequest"
      },
      "EditOp": {
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "set_position",
              "set_pitch",
              "delete",
              "add",
              "set_duration"
            ],
            "title": "Op"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "op"
        ],
        "title": "EditOp",
        "description": "One edit operation (ADR-0011). The API checks only its kind; the worker checks the rest\nagainst the score (the API never runs pipeline code)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Instrument": {
        "type": "string",
        "enum": [
          "guitar",
          "piano"
        ],
        "title": "Instrument"
      },
      "JobError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "JobError"
      },
      "JobList": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobSummary"
            },
            "type": "array",
            "title": "Jobs"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "jobs",
          "next_cursor"
        ],
        "title": "JobList"
      },
      "JobOptions": {
        "properties": {
          "instrument": {
            "$ref": "#/components/schemas/Instrument"
          },
          "tuning": {
            "$ref": "#/components/schemas/Tuning",
            "default": "standard"
          },
          "capo": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 0.0,
            "title": "Capo",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "instrument",
          "tuning",
          "capo"
        ],
        "title": "JobOptions",
        "description": "What the client can choose. Stored as the job's config and read by the worker as the\npipeline's `PipelineConfig` (a test keeps the two compatible). The API doesn't import the\npipeline: it would pull the ML libraries into the API."
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "options": {
            "$ref": "#/components/schemas/JobOptions"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "submitted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Submitted At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "pipeline_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pipeline Version"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ]
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/StageOut"
            },
            "type": "array",
            "title": "Stages"
          },
          "outputs": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobOutputs"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "options",
          "created_at",
          "submitted_at",
          "finished_at",
          "pipeline_version",
          "error",
          "stages",
          "outputs"
        ],
        "title": "JobOut"
      },
      "JobOutputs": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "musicxml": {
            "$ref": "#/components/schemas/PresignedRequestOut"
          },
          "tab_musicxml": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PresignedRequestOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "midi": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PresignedRequestOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "sync": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PresignedRequestOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "version",
          "musicxml",
          "tab_musicxml",
          "midi",
          "sync"
        ],
        "title": "JobOutputs",
        "description": "Presigned downloads of the job's latest score version."
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "pending_upload",
          "queued",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "JobStatus"
      },
      "JobSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "instrument": {
            "$ref": "#/components/schemas/Instrument"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "instrument",
          "created_at"
        ],
        "title": "JobSummary"
      },
      "MeOut": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "jobs_this_month": {
            "type": "integer",
            "title": "Jobs This Month"
          },
          "jobs_per_month": {
            "type": "integer",
            "title": "Jobs Per Month"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "jobs_this_month",
          "jobs_per_month"
        ],
        "title": "MeOut"
      },
      "PresignedRequestOut": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Headers"
          },
          "expires_in_s": {
            "type": "integer",
            "title": "Expires In S"
          }
        },
        "type": "object",
        "required": [
          "method",
          "url",
          "headers",
          "expires_in_s"
        ],
        "title": "PresignedRequestOut"
      },
      "PushTokenIn": {
        "properties": {
