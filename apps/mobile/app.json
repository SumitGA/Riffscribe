{
  "expo": {
    "name": "Riffscribe",
    "slug": "riffscribe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "riffscribe",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sumitga.riffscribe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sumitga.riffscribe"
    },
    "plugins": [
      "expo-router",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Riffscribe records what you play so it can transcribe it."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
