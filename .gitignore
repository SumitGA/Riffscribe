# Local test recordings and pipeline output: never commit these.
# Only deliberate test fixtures under tests/fixtures/ are tracked.
*.m4a
*.mp3
*.wav
*.flac
*.aac
*.ogg
*.mid
*.midi
*.npz
!**/tests/fixtures/**
# ...but never caches, even inside fixtures (the line above would re-include them).
**/__pycache__/
